<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acknowledgement & Auto QR Billing App</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- QRCode.js Library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <!-- HTML5-QRCode Scanner Library -->
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <!-- html2canvas Library for Receipt PNG Export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            creamy: '#FAF8F5',
            softOrange: '#FF9E64',
            softOrangeHover: '#FF8A43',
            lightOrange: '#FFC499',
            brandDark: '#1E293B'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    * { -webkit-tap-highlight-color: transparent; }
    .qr-card-shadow { box-shadow: 0 10px 25px -5px rgba(255, 158, 100, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.05); }
    .tab-btn.active { background-color: #FF9E64; color: #FFFFFF; font-weight: 600; }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.05); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .animate-pulse-ring { animation: pulse-ring 2s infinite ease-in-out; }
    .blur-card { filter: blur(6px); pointer-events: none; opacity: 0.45; transition: all 0.3s ease; }
  </style>

   <!-- Firebase SDK Imports with fallback handling -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, doc, setDoc, getDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    window.isFirebaseReady = false;
    try {
      const appId = typeof __app_id !== 'undefined' ? __app_id : 'ack-billing-multi-sync-app';
      const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { apiKey: "demo", projectId: "demo" };

      const app = initializeApp(firebaseConfig);
      const db = getFirestore(app);
      const auth = getAuth(app);

      window.db = db;
      window.appId = appId;
      window.auth = auth;
      window.firebaseModules = { doc, setDoc, getDoc, onSnapshot, collection };

      async function initAuth() {
        try {
          if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
            await signInWithCustomToken(auth, __initial_auth_token);
          } else {
            await signInAnonymously(auth);
          }
        } catch (e) {
          console.warn("Auth fallback:", e);
        }
        window.isFirebaseReady = true;
        if (window.onFirebaseReady) window.onFirebaseReady();
      }
      initAuth();
    } catch (err) {
      console.warn("Firebase initialization warning, running local fallback mode:", err);
      window.isFirebaseReady = true;
      if (window.onFirebaseReady) window.onFirebaseReady();
    }
  </script>
</head>
<body class="bg-creamy text-slate-800 font-sans min-h-screen flex flex-col selection:bg-lightOrange/30">

  <!-- Header & Navigation -->
  <header class="bg-white/80 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-softOrange/15 flex items-center justify-center text-softOrange font-bold text-xl">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
          </svg>
        </div>
        <div>
          <h1 class="font-bold text-slate-900 text-lg leading-tight">AckBilling</h1>
          <p class="text-xs text-slate-500 font-medium">Auto-QR & Multi-Scan Portal</p>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex bg-slate-100 p-1 rounded-2xl border border-slate-200/60">
        <button id="tabQrGen" onclick="switchTab('qrGen')" class="tab-btn active px-4 py-2 rounded-xl text-xs md:text-sm transition-all duration-200 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>Auto QRs (5)</span>
        </button>
        <button id="tabScanner" onclick="switchTab('scanner')" class="tab-btn px-4 py-2 rounded-xl text-xs md:text-sm text-slate-600 transition-all duration-200 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
          <span>Scan & Entry</span>
          <span id="cartCountBadge" class="hidden bg-softOrange text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
        </button>
      </nav>
    </div>
  </header>

    <!-- Main Content Container -->
  <main class="max-w-6xl mx-auto px-4 py-6 flex-1 w-full">

    <!-- VIEW 1: 10 Auto-Generating QR Codes Screen -->
    <section id="viewQrGen" class="space-y-6">
      <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Live Auto-Generated QRs (Synchronized Pool of 10)</h2>
          <p class="text-xs text-slate-500 mt-1">
            All connected devices display the <span class="font-semibold text-softOrange">exact same 10 QR codes</span>. Scanning any QR instantly locks and blurs it across all devices with <span class="font-semibold text-emerald-600">Under Working</span> status.
          </p>
        </div>
        <button onclick="regenerateAllQrs()" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold shadow-sm transition-all flex items-center gap-2 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          <span>Regenerate Pool</span>
        </button>
      </div>

      <!-- 10 QR Codes Grid -->
      <div id="qrGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        <!-- JS dynamically renders 10 QR Cards here -->
      </div>
    </section>

    <!-- VIEW 2: Scanner & Entry / Billing Page -->
    <section id="viewScanner" class="hidden space-y-6">
      
      <!-- Top Action Control Bar -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Mode Switcher -->
        <div class="bg-white p-4 rounded-3xl border border-slate-100 shadow-sm md:col-span-2 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div id="modeIconBg" class="w-10 h-10 rounded-2xl bg-orange-100 text-softOrange flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </div>
            <div>
              <h3 id="modeTitle" class="font-bold text-slate-800 text-sm">Active Mode: Entry Setup</h3>
              <p id="modeDesc" class="text-xs text-slate-500">Scan QR to configure product details (Name, Price, Color, etc.)</p>
            </div>
          </div>
          <div class="flex bg-slate-100 p-1 rounded-xl w-full sm:w-auto">
            <button id="btnModeEntry" onclick="setScanMode('entry')" class="flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg bg-white text-slate-800 shadow-sm">Entry Mode</button>
            <button id="btnModeBilling" onclick="setScanMode('billing')" class="flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg text-slate-500">Billing Mode</button>
          </div>
        </div>

                <!-- Direct Manual ID Fallback Box -->
        <div class="bg-white p-4 rounded-3xl border border-slate-100 shadow-sm flex items-center gap-2">
          <input id="manualQrInput" type="text" placeholder="Enter or paste QR ID..." class="w-full text-xs py-2.5 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange">
          <button onclick="handleManualQrSubmit()" class="px-4 py-2.5 bg-softOrange hover:bg-softOrangeHover text-white text-xs font-bold rounded-xl shrink-0">Go</button>
        </div>
      </div>

      <!-- Main Scanner + Result Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Camera Scanner Box -->
        <div class="lg:col-span-5 bg-white p-5 rounded-3xl border border-slate-100 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h4 class="font-bold text-slate-800 text-sm flex items-center gap-2">
              <span id="scanDotIndicator" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="scanStatusTitle">Live Camera Scanner</span>
            </h4>
            <div class="flex items-center gap-2">
              <span id="scanStatusIndicator" class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-md font-bold border border-emerald-200">Active</span>
            </div>
          </div>

          <!-- Html5Qrcode Scanner Target -->
          <div id="reader" class="overflow-hidden rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 min-h-[260px] flex items-center justify-center relative"></div>
          
          <!-- Restart Scanner Button when paused -->
          <div id="scannerResumeContainer" class="hidden text-center">
            <button onclick="resumeCameraScanner()" class="w-full py-2.5 bg-slate-900 text-white rounded-xl text-xs font-bold shadow-sm hover:bg-slate-800 transition-all">
              🔄 Resume Live Camera Scan
            </button>
          </div>

          <!-- Scan Alert Box for invalid/external QRs -->
          <div id="scanAlertBox" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-semibold text-center animate-shake">
            ⚠️ Not available! This is an unrecognized or external QR code.
          </div>

          <div class="text-center">
            <label class="cursor-pointer inline-flex items-center gap-2 text-xs font-semibold text-softOrange hover:text-softOrangeHover">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Or Upload QR Image File</span>
              <input type="file" id="qrFileInput" accept="image/*" class="hidden" onchange="handleFileInput(this)">
            </label>
          </div>
        </div>

        <!-- Right: Dynamic Action Panel (Form OR Billing Cart) -->
        <div class="lg:col-span-7">

                    <!-- Entry Form (When Mode = Entry) -->
          <div id="entryFormCard" class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-5">
            <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
              <div>
                <h3 class="font-bold text-slate-900 text-base">QR Product Entry Form</h3>
                <p id="entryScannedIdText" class="text-xs text-softOrange font-medium">Scan or enter valid app QR code above</p>
              </div>
              <div class="flex items-center gap-2">
                <!-- Replaced Under Working badge with a Cancel / Cross button -->
                <button type="button" id="cancelEntryBtn" onclick="cancelCurrentQrEntry()" class="hidden px-3 py-1 bg-red-50 hover:bg-red-100 text-red-600 font-bold text-xs rounded-xl border border-red-200 transition-all flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  <span>Cancel / Reset</span>
                </button>
                <!-- AI Product Photo Auto-Fill Button -->
                <button type="button" onclick="openProductCameraModal()" class="w-9 h-9 rounded-full bg-softOrange/15 text-softOrange hover:bg-softOrange hover:text-white transition-all flex items-center justify-center border border-softOrange/30 shadow-sm shrink-0" title="Auto-fill details from product photo">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </button>
              </div>
            </div>

            <form id="productEntryForm" onsubmit="handleSaveProduct(event)" class="space-y-4">
              <input type="hidden" id="formQrId" value="">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Product / Item Name *</label>
                  <input type="text" id="itemName" required placeholder="e.g. Cotton T-Shirt" class="w-full text-xs py-2.5 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Price (₹ / Amount) *</label>
                  <input type="number" id="itemPrice" step="0.01" min="0" required placeholder="e.g. 499" class="w-full text-xs py-2.5 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange">
                </div>
              </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Quantity *</label>
                  <input type="number" id="itemQty" min="1" value="1" required class="w-full text-xs py-2.5 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Quality / Grade</label>
                  <select id="itemQuality" class="w-full text-xs py-2.5 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange">
                    <option value="Premium">Premium</option>
                    <option value="Standard">Standard</option>
                    <option value="Economy">Economy</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-600 mb-1">Color</label>
                  <input type="text" id="itemColor" placeholder="e.g. Royal Blue" class="w-full text-xs py-2.5 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange">
                </div>
              </div>

              <!-- New Bio / Notes Field -->
              <div>
                <div class="flex items-center justify-between mb-1">
                  <label class="block text-xs font-semibold text-slate-600">Bio / Notes (Optional)</label>
                  <span id="bioCharCount" class="text-[10px] text-slate-400">0/250</span>
                </div>
                               <textarea id="itemBio" maxlength="250" rows="2" placeholder="Add custom notes or product bio here (max 250 characters)..." oninput="updateBioCounter(this)" class="w-full text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-softOrange resize-none"></textarea>
              </div>

              <button type="submit" id="saveEntryBtn" class="w-full py-3.5 bg-softOrange hover:bg-softOrangeHover text-white font-bold text-sm rounded-xl shadow-md transition-all active:scale-[0.99] flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Save Product Details & Ready QR</span>
              </button>
            </form>
          </div>

          <!-- Billing Cart & Receipt (When Mode = Billing) -->
          <div id="billingCartCard" class="hidden bg-white p-6 rounded-3xl border border-slate-100 shadow-sm space-y-5">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
              <div>
                <h3 class="font-bold text-slate-900 text-base">Multi-Item Invoice / Bill</h3>
                <p class="text-xs text-slate-500">Scan multiple registered app QR codes to add items automatically</p>
              </div>
              <button onclick="clearBillCart()" class="text-xs text-red-500 hover:text-red-700 font-medium">Clear All</button>
            </div>

            <!-- Printable & Exportable Clean Bill Container -->
            <div id="receiptPrintArea" class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4">
              <!-- Bill Header Info -->
              <div class="flex flex-col sm:flex-row justify-between items-start border-b border-slate-200 pb-3 gap-2">
                <div class="space-y-1">
                  <h4 class="text-base font-extrabold text-slate-900 uppercase tracking-wide leading-tight">ACKNOWLEDGEMENT RECEIPT</h4>
                  <div id="receiptBillNo" class="text-xs font-mono font-bold text-softOrange">Bill #: INV-000000</div>
                </div>
                <div class="text-left sm:text-right text-[11px] text-slate-500 font-medium shrink-0">
                  <p id="receiptDate">Date: --/--/----</p>
                  <p id="receiptTime">Time: --:--</p>
                </div>
              </div>
      <!-- Scanned Items Table -->
              <div class="overflow-x-auto min-h-[140px] max-h-[280px] overflow-y-auto">
                <table class="w-full text-left border-collapse">
                  <thead>
                    <tr class="border-b border-slate-200 text-[11px] text-slate-400 font-bold uppercase tracking-wider">
                      <th class="py-2 px-2">Item</th>
                      <th class="py-2 px-2">Color / Quality</th>
                      <th class="py-2 px-2 text-center">Qty</th>
                      <th class="py-2 px-2 text-right">Price</th>
                      <th class="py-2 px-2 text-right">Total</th>
                    </tr>
                  </thead>
                  <tbody id="receiptTableBody">
                    <tr>
                      <td colspan="5" class="py-8 text-center text-xs text-slate-400 italic">No QR codes scanned yet. Scan app QRs to build bill.</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <!-- Total Calculation Summary & Embedded Bill QR -->
              <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/80 flex items-center justify-between gap-4">
                <div class="space-y-1">
                  <div class="text-xs text-slate-600">
                    <span>Total Scanned Items:</span>
                    <span id="billItemCount" class="font-bold text-slate-900 ml-1">0</span>
                  </div>
                  <div class="text-sm md:text-base font-extrabold text-slate-900">
                    <span>Grand Total:</span>
                    <span id="billGrandTotal" class="text-softOrange ml-1">₹ 0.00</span>
                  </div>
                </div>

                <!-- Proof Verification QR embedded inside bill -->
                <div class="flex flex-col items-center justify-center shrink-0">
                  <div id="receiptQrCanvas" class="w-16 h-16 p-1 bg-white border border-slate-200 rounded-lg flex items-center justify-center overflow-hidden"></div>
                  <span class="text-[9px] font-semibold text-slate-400 mt-1">Scan Verification</span>
                </div>
              </div>
            </div>

            <!-- Action Buttons for Bill Export -->
            <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
              <button onclick="downloadBillImage()" class="w-full sm:flex-1 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span>Download Bill Image (Gallery)</span>
              </button>
              <button onclick="printBillReceipt()" class="w-full sm:flex-1 py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-md transition-all active:scale-[0.98] flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                <span>Print Receipt</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Camera Snapshot Modal for Auto-Fill -->
  <div id="productPhotoModal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-5 max-w-sm w-full space-y-4 shadow-2xl border border-slate-100">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2">
        <h4 class="font-bold text-slate-800 text-sm flex items-center gap-2">
          <svg class="w-4 h-4 text-softOrange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span>Scan Product Photo</span>
        </h4>
        <button onclick="closeProductCameraModal()" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
      </div>

      <div class="relative overflow-hidden rounded-2xl bg-slate-900 aspect-square flex items-center justify-center">
        <video id="productCamVideo" autoplay playsinline class="w-full h-full object-cover"></video>
        <canvas id="productCamCanvas" class="hidden"></canvas>
        <img id="productCamPreview" class="hidden w-full h-full object-cover" />
        <div id="aiExtractLoader" class="hidden absolute inset-0 bg-slate-900/80 backdrop-blur-sm flex flex-col items-center justify-center space-y-2 text-white p-4 text-center">
          <div class="w-8 h-8 border-3 border-softOrange border-t-transparent rounded-full animate-spin"></div>
          <p class="text-xs font-semibold">AI is analyzing product image...</p>
          <p class="text-[10px] text-slate-300">Auto-filling details into form</p>
        </div>
      </div>

          <div class="flex items-center gap-2">
        <button id="snapAiBtn" onclick="captureAndExtractProductInfo()" class="flex-1 py-3 bg-softOrange hover:bg-softOrangeHover text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/></svg>
          <span>Snap & Auto-Fill</span>
        </button>
        <button id="reclickBtn" onclick="resetProductCameraView()" class="hidden flex-1 py-3 bg-slate-700 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-all flex items-center justify-center gap-1">
          🔄 Re-click
        </button>
        <button id="saveCamDetailsBtn" onclick="confirmProductCamSave()" class="hidden flex-1 py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-md transition-all flex items-center justify-center gap-1">
          ✓ Save Details
        </button>
        <button onclick="closeProductCameraModal()" class="py-3 px-3 bg-slate-100 text-slate-600 text-xs font-semibold rounded-xl">Cancel</button>
      </div>
    </div>
  </div>

  <script>
    // Application Global State
    let activeTab = 'qrGen';
    let currentScanMode = 'entry'; // 'entry' or 'billing'
    let qrPool = [];
    let registeredDatabase = {}; // Stores details indexed by QR ID
    let lockedQrIds = {}; // Tracks QRs currently under working across devices { qrId: true }
    let scannedBillCart = []; // Bill cart items
    let currentBillNo = 'INV-' + Math.floor(100000 + Math.random() * 900000);
    let activeQrForEntry = null;
    let html5QrCodeScanner = null;
    let lastScannedCode = null;
    let lastScanTime = 0;
    let isScannerPaused = false;
    let unsubFirestore = null;
    let productCamStream = null;
    let tempExtractedData = null;

    // Camera Auto-Fill AI integration
    async function openProductCameraModal() {
      const modal = document.getElementById('productPhotoModal');
      const video = document.getElementById('productCamVideo');
      resetProductCameraView();
      modal.classList.remove('hidden');
      try {
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        productCamStream = await navigator.mediaDevices.getUserMedia({
          video: isMobile ? { facingMode: 'environment' } : { facingMode: 'user' }
        });
        video.srcObject = productCamStream;
      } catch (err) {
        alert('Unable to access camera for product snapshot: ' + err.message);
        closeProductCameraModal();
      }
    }

    function resetProductCameraView() {
      const video = document.getElementById('productCamVideo');
      const preview = document.getElementById('productCamPreview');
      const snapBtn = document.getElementById('snapAiBtn');
      const reclickBtn = document.getElementById('reclickBtn');
      const saveBtn = document.getElementById('saveCamDetailsBtn');
      
      video.classList.remove('hidden');
      preview.classList.add('hidden');
      snapBtn.classList.remove('hidden');
      reclickBtn.classList.add('hidden');
      saveBtn.classList.add('hidden');
      tempExtractedData = null;
    }

    function closeProductCameraModal() {
      const modal = document.getElementById('productPhotoModal');
      modal.classList.add('hidden');
      document.getElementById('aiExtractLoader').classList.add('hidden');
      if (productCamStream) {
        productCamStream.getTracks().forEach(track => track.stop());
        productCamStream = null;
      }
    }

    async function captureAndExtractProductInfo() {
      const video = document.getElementById('productCamVideo');
      const canvas = document.getElementById('productCamCanvas');
      const preview = document.getElementById('productCamPreview');
      const loader = document.getElementById('aiExtractLoader');
      const snapBtn = document.getElementById('snapAiBtn');
      const reclickBtn = document.getElementById('reclickBtn');
      const saveBtn = document.getElementById('saveCamDetailsBtn');
      
      if (!video || !video.videoWidth) return;

      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
      preview.src = dataUrl;
      video.classList.add('hidden');
      preview.classList.remove('hidden');

      const base64Data = dataUrl.split(',')[1];
      loader.classList.remove('hidden');

      try {
        const apiKey = "";
        const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

        const payload = {
          contents: [{
            role: 'user',
            parts: [
              { text: 'Analyze this product image. Extract and return JSON with keys: "name" (product title), "price" (estimated number in INR), "quality" ("Premium", "Standard", or "Economy"), "color" (main dominant color), and "bio" (brief 1-2 sentence description max 150 chars).' },
              { inlineData: { mimeType: 'image/jpeg', data: base64Data } }
            ]
          }],
          generationConfig: {
            responseMimeType: 'application/json'
          }
        };

        const resp = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await resp.json();
        const jsonText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        
        if (jsonText) {
          tempExtractedData = JSON.parse(jsonText);
        }
      } catch (e) {
        console.warn('AI Extraction fallback:', e);
      } finally {
        loader.classList.add('hidden');
        snapBtn.classList.add('hidden');
        reclickBtn.classList.remove('hidden');
        saveBtn.classList.remove('hidden');
      }
    }

    function confirmProductCamSave() {
      if (tempExtractedData) {
        if (tempExtractedData.name) document.getElementById('itemName').value = tempExtractedData.name;
        if (tempExtractedData.price) document.getElementById('itemPrice').value = tempExtractedData.price;
        if (tempExtractedData.quality) document.getElementById('itemQuality').value = tempExtractedData.quality;
        if (tempExtractedData.color) document.getElementById('itemColor').value = tempExtractedData.color;
        if (tempExtractedData.bio) {
          document.getElementById('itemBio').value = tempExtractedData.bio;
          updateBioCounter(document.getElementById('itemBio'));
        }
        showScanAlert(`✨ AI details extracted for "${tempExtractedData.name || 'Product'}"!`);
      }
      closeProductCameraModal();
    }

    // BroadcastChannel for instant local multi-tab / multi-window sync fallback
    const syncChannel = new BroadcastChannel('ack_billing_sync_channel');
    syncChannel.onmessage = (event) => {
      if (event.data && event.data.type === 'STATE_UPDATE') {
        const state = event.data.payload;
        if (state.qrPool) qrPool = state.qrPool;
        if (state.lockedQrIds) lockedQrIds = state.lockedQrIds;
        if (state.registeredDatabase) registeredDatabase = state.registeredDatabase;
        renderQrGrid();
      }
    };

    // Beep sound effect using Web Audio API
    function playBeepSound() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime + 0.2);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.2);
      } catch (e) {}
    }

    // Sync state to Cloud & Local Storage
    async function syncStateToCloud() {
      const statePayload = {
        qrPool: qrPool,
        lockedQrIds: lockedQrIds,
        registeredDatabase: registeredDatabase,
        updatedAt: Date.now()
      };

      try {
        localStorage.setItem('ack_billing_state', JSON.stringify(statePayload));
        syncChannel.postMessage({ type: 'STATE_UPDATE', payload: statePayload });
      } catch (e) {}

      if (!window.isFirebaseReady || !window.db) return;
      try {
        const { doc, setDoc } = window.firebaseModules;
        const docRef = doc(window.db, 'artifacts', window.appId, 'public', 'data', 'live_sync_state', 'main');
        await setDoc(docRef, statePayload, { merge: true });
      } catch (e) {
        console.warn('Firebase sync notice:', e);
      }
    }

    function initRealtimeSync() {
      try {
        const local = localStorage.getItem('ack_billing_state');
        if (local) {
          const parsed = JSON.parse(local);
          if (parsed.qrPool && parsed.qrPool.length > 0) qrPool = parsed.qrPool;
          if (parsed.lockedQrIds) lockedQrIds = parsed.lockedQrIds;
          if (parsed.registeredDatabase) registeredDatabase = parsed.registeredDatabase;
        }
      } catch (e) {}

      if (qrPool.length === 0) {
        initQrPool();
      } else {
        renderQrGrid();
      }

      if (!window.db) return;
      try {
        const { doc, onSnapshot } = window.firebaseModules;
        const docRef = doc(window.db, 'artifacts', window.appId, 'public', 'data', 'live_sync_state', 'main');
        
        unsubFirestore = onSnapshot(docRef, (docSnap) => {
          if (docSnap.exists()) {
            const data = docSnap.data();
            if (data.qrPool && Array.isArray(data.qrPool) && data.qrPool.length > 0) {
              qrPool = data.qrPool;
            }
            if (data.lockedQrIds) {
              lockedQrIds = data.lockedQrIds;
            }
            if (data.registeredDatabase) {
              registeredDatabase = data.registeredDatabase;
            }
            renderQrGrid();
          }
        }, (error) => {});
      } catch (err) {}
    }

    // Initialize 10 Auto QR pool (without timer expiry)
    function initQrPool() {
      qrPool = [];
      for (let i = 1; i <= 10; i++) {
        const id = 'ACK-' + Math.floor(1000 + Math.random() * 9000);
        qrPool.push({ id: id });
      }
      lockedQrIds = {};
      syncStateToCloud();
      renderQrGrid();
    }

    function regenerateAllQrs() {
      initQrPool();
    }

    function renderQrGrid() {
      const grid = document.getElementById('qrGrid');
      if (!grid) return;
      
      const existingCards = grid.children;
      if (existingCards.length !== qrPool.length) {
        grid.innerHTML = '';
        qrPool.forEach((item, index) => {
          const card = document.createElement('div');
          card.id = `qrCardSlot_${index}`;
          grid.appendChild(card);
        });
      }

      qrPool.forEach((item, index) => {
        const card = document.getElementById(`qrCardSlot_${index}`) || document.createElement('div');
        if (!card.id) {
          card.id = `qrCardSlot_${index}`;
          grid.appendChild(card);
        }

        const isLocked = lockedQrIds[item.id] || (activeQrForEntry === item.id);
        const isReg = !!registeredDatabase[item.id];

        const expectedClassName = `bg-white p-4 rounded-3xl border border-slate-100 shadow-sm flex flex-col items-center justify-between space-y-3 relative group transition-all ${isLocked ? 'blur-card ring-2 ring-emerald-500' : 'hover:border-softOrange/40'}`;
        if (card.className !== expectedClassName) {
          card.className = expectedClassName;
        }

        const timeStatusText = isLocked ? '🔒 LOCKED' : 'ID ACTIVE';
        const badgeStatusText = isLocked ? '🔒 Putting Details' : (isReg ? '✓ Registered' : '• Unregistered');
        const badgeClassText = isLocked ? 'bg-amber-100 text-amber-800 font-extrabold border border-amber-300' : (isReg ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-50 text-slate-400 border border-slate-100');
        const timeBadgeClass = isLocked ? 'bg-amber-100 text-amber-700' : 'bg-orange-100 text-softOrange';

        const headerId = `qrid_text_${index}`;
        const timeId = `qrtime_text_${index}`;
        const badgeId = `qrbadge_text_${index}`;
        const canvasContainerId = `qrCanvas_${index}`;

        if (!document.getElementById(headerId)) {
          card.innerHTML = `
            <div class="w-full flex items-center justify-between text-xs font-mono">
              <span id="${headerId}" class="font-bold text-slate-800">${item.id}</span>
              <span id="${timeId}" class="px-2 py-0.5 rounded-full font-bold text-[10px] ${timeBadgeClass}">
                ${timeStatusText}
              </span>
            </div>

            <div id="${canvasContainerId}" class="w-32 h-32 p-2 bg-slate-50 rounded-2xl border border-slate-100 flex items-center justify-center overflow-hidden"></div>

            <div class="w-full space-y-1">
              <div id="${badgeId}" class="text-[11px] text-center font-bold px-2 py-1 rounded-lg ${badgeClassText}">
                ${badgeStatusText}
              </div>
            </div>
          `;

          setTimeout(() => {
            const canvasBox = document.getElementById(canvasContainerId);
            if (canvasBox && canvasBox.childElementCount === 0 && typeof QRCode !== 'undefined') {
              new QRCode(canvasBox, {
                text: item.id,
                width: 100,
                height: 100,
                colorDark: "#1E293B",
                colorLight: "#F8FAFC",
                correctLevel: QRCode.CorrectLevel.M
              });
            }
          }, 20);
        } else {
          document.getElementById(headerId).textContent = item.id;
          document.getElementById(timeId).textContent = timeStatusText;
          document.getElementById(timeId).className = `px-2 py-0.5 rounded-full font-bold text-[10px] ${timeBadgeClass}`;
          const badgeEl = document.getElementById(badgeId);
          badgeEl.textContent = badgeStatusText;
          badgeEl.className = `text-[11px] text-center font-bold px-2 py-1 rounded-lg ${badgeClassText}`;
        }
      });
    }

    // Cancel current QR scan and unlock across all devices
    function cancelCurrentQrEntry() {
      if (activeQrForEntry) {
        delete lockedQrIds[activeQrForEntry];
        activeQrForEntry = null;
      }
      document.getElementById('productEntryForm').reset();
      document.getElementById('formQrId').value = '';
      document.getElementById('entryScannedIdText').textContent = 'Scan or enter valid app QR code above';
      document.getElementById('cancelEntryBtn').classList.add('hidden');
      updateBioCounter(document.getElementById('itemBio'));
      
      syncStateToCloud();
      renderQrGrid();
      resumeCameraScanner();
      showScanAlert('🔄 Entry process cancelled. QR unlocked across all devices.');
    }
   // Handle Scanned QR Code
    function processScannedQr(qrId) {
      qrId = qrId.trim();
      const now = Date.now();

      if (qrId === lastScannedCode && (now - lastScanTime) < 2500) return;

      if (!isValidAppQr(qrId)) {
        showScanAlert(`⚠️ Not available! "${qrId}" is an unrecognized or external QR code.`);
        return;
      }

      if (lockedQrIds[qrId] && activeQrForEntry !== qrId && currentScanMode === 'entry') {
        showScanAlert(`🔒 This QR code [${qrId}] is already under working on another device!`);
        return;
      }

      lastScannedCode = qrId;
      lastScanTime = now;
      playBeepSound();

      let foundInPool = qrPool.find(q => q.id === qrId);
      if (!foundInPool && !registeredDatabase[qrId]) {
        qrPool.unshift({ id: qrId });
        if (qrPool.length > 10) qrPool.pop();
      }

      if (currentScanMode === 'entry') {
        pauseCameraScanner();
        activeQrForEntry = qrId;
        lockedQrIds[qrId] = true;
        
        // Auto download QR file to device on scan
        autoDownloadScannedQr(qrId);

        syncStateToCloud();
        renderQrGrid();

        document.getElementById('formQrId').value = qrId;
        document.getElementById('entryScannedIdText').textContent = `✓ Scanned & Locked QR ID: ${qrId} (Synced & Blurred across all devices)`;

        // Show cancel cross button
        document.getElementById('cancelEntryBtn').classList.remove('hidden');

        if (registeredDatabase[qrId]) {
          const item = registeredDatabase[qrId];
          document.getElementById('itemName').value = item.name;
          document.getElementById('itemPrice').value = item.price;
          document.getElementById('itemQty').value = item.qty;
          document.getElementById('itemQuality').value = item.quality;
          document.getElementById('itemColor').value = item.color;
          document.getElementById('itemBio').value = item.bio || '';
          updateBioCounter(document.getElementById('itemBio'));
        } else {
          document.getElementById('productEntryForm').reset();
          document.getElementById('formQrId').value = qrId;
          document.getElementById('itemQty').value = 1;
          updateBioCounter(document.getElementById('itemBio'));
        }
      } else {
        if (registeredDatabase[qrId]) {
          const item = registeredDatabase[qrId];
          scannedBillCart.push({ ...item, scannedAt: new Date().toLocaleTimeString() });
          updateBillDisplay();
          showScanAlert(`✓ Added "${item.name}" to bill cart successfully!`);
        } else {
          showScanAlert(`⚠️ QR Code [${qrId}] is not registered in Entry Mode yet!`);
        }
      }
    }

    function handleSaveProduct(e) {
      e.preventDefault();
      const qrId = document.getElementById('formQrId').value || activeQrForEntry;
      if (!qrId) {
        alert('Please scan a valid app QR code first.');
        return;
      }

      registeredDatabase[qrId] = {
        id: qrId,
        name: document.getElementById('itemName').value.trim(),
        price: parseFloat(document.getElementById('itemPrice').value) || 0,
        qty: parseInt(document.getElementById('itemQty').value) || 1,
        quality: document.getElementById('itemQuality').value,
        color: document.getElementById('itemColor').value.trim() || 'N/A',
        bio: document.getElementById('itemBio').value.trim()
      };

      delete lockedQrIds[qrId];
      
      // Replace ONLY this specific scanned QR slot with a new unique QR ID
      const poolIndex = qrPool.findIndex(q => q.id === qrId);
      const newQrId = 'ACK-' + Math.floor(1000 + Math.random() * 9000);
      if (poolIndex !== -1) {
        qrPool[poolIndex] = { id: newQrId };
      }

      activeQrForEntry = null;
      document.getElementById('cancelEntryBtn').classList.add('hidden');
      syncStateToCloud();
      
      // Force refresh of the grid DOM so canvas re-renders cleanly for the new ID
      document.getElementById('qrGrid').innerHTML = '';
      renderQrGrid();

      showScanAlert(`✓ Details saved! Only this QR code [${qrId}] was replaced with [${newQrId}] across all devices.`);
      
      resumeCameraScanner();
    }

    // Tab Navigation Switcher
    function switchTab(tab) {
      activeTab = tab;
      const viewQrGen = document.getElementById('viewQrGen');
      const viewScanner = document.getElementById('viewScanner');
      const tabQrGen = document.getElementById('tabQrGen');
      const tabScanner = document.getElementById('tabScanner');

      if (tab === 'qrGen') {
        viewQrGen.classList.remove('hidden');
        viewScanner.classList.add('hidden');
        tabQrGen.classList.add('active');
        tabQrGen.classList.remove('text-slate-600');
        tabScanner.classList.remove('active');
        tabScanner.classList.add('text-slate-600');
        stopCameraScanner();
      } else {
        viewQrGen.classList.add('hidden');
        viewScanner.classList.remove('hidden');
        tabScanner.classList.add('active');
        tabScanner.classList.remove('text-slate-600');
        tabQrGen.classList.remove('active');
        tabQrGen.classList.add('text-slate-600');
        initCameraScanner();
      }
    }

    // Set Scan Mode (Entry vs Billing)
    function setScanMode(mode) {
      currentScanMode = mode;
      const btnModeEntry = document.getElementById('btnModeEntry');
      const btnModeBilling = document.getElementById('btnModeBilling');
      const entryFormCard = document.getElementById('entryFormCard');
      const billingCartCard = document.getElementById('billingCartCard');
      const modeTitle = document.getElementById('modeTitle');
      const modeDesc = document.getElementById('modeDesc');

      if (mode === 'entry') {
        btnModeEntry.className = 'flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg bg-white text-slate-800 shadow-sm';
        btnModeBilling.className = 'flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg text-slate-500';
        entryFormCard.classList.remove('hidden');
        billingCartCard.classList.add('hidden');
        modeTitle.textContent = 'Active Mode: Entry Setup';
        modeDesc.textContent = 'Scan QR to configure product details (Name, Price, Color, etc.)';
      } else {
        btnModeBilling.className = 'flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg bg-white text-slate-800 shadow-sm';
        btnModeEntry.className = 'flex-1 sm:flex-none px-3 py-1.5 text-xs font-bold rounded-lg text-slate-500';
        billingCartCard.classList.remove('hidden');
        entryFormCard.classList.add('hidden');
        modeTitle.textContent = 'Active Mode: Billing Cart';
        modeDesc.textContent = 'Scan registered QRs to build bill invoice';
      }
          }
    // Camera Scanner Initialization
    function initCameraScanner() {
      if (html5QrCodeScanner) return;
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      
      html5QrCodeScanner = new Html5Qrcode("reader");
      const config = { fps: 10, qrbox: { width: 220, height: 220 } };

      html5QrCodeScanner.start(
        { facingMode: isMobile ? "environment" : "user" },
        config,
        (decodedText) => {
          processScannedQr(decodedText);
        },
        (errorMessage) => {}
      ).catch((err) => {
        console.warn("Camera scan start error:", err);
      });
    }

    function stopCameraScanner() {
      if (html5QrCodeScanner) {
        try {
          // Check if scanner state allows stopping cleanly
          const state = html5QrCodeScanner.getState();
          // Html5QrcodeScannerState: SCANNING = 2, PAUSED = 3
          if (state === 2 || state === 3) {
            html5QrCodeScanner.stop().then(() => {
              try { html5QrCodeScanner.clear(); } catch(e){}
              html5QrCodeScanner = null;
            }).catch(err => {
              html5QrCodeScanner = null;
            });
          } else {
            try { html5QrCodeScanner.clear(); } catch(e){}
            html5QrCodeScanner = null;
          }
        } catch (e) {
          html5QrCodeScanner = null;
        }
      }
    }

    function pauseCameraScanner() {
      if (html5QrCodeScanner) {
        try { 
          const state = html5QrCodeScanner.getState();
          if (state === 2) { // Only pause if currently scanning
            html5QrCodeScanner.pause(); 
          }
        } catch(e){}
      }
      isScannerPaused = true;
      document.getElementById('scannerResumeContainer').classList.remove('hidden');
    }

    function resumeCameraScanner() {
      if (html5QrCodeScanner && isScannerPaused) {
        try { 
          const state = html5QrCodeScanner.getState();
          if (state === 3) { // Only resume if currently paused
            html5QrCodeScanner.resume(); 
          }
        } catch(e){}
      }
      isScannerPaused = false;
      document.getElementById('scannerResumeContainer').classList.add('hidden');
    }

    function isValidAppQr(code) {
      return /^ACK-\d{4}$/.test(code) || !!registeredDatabase[code] || qrPool.some(q => q.id === code);
    }

    function showScanAlert(msg) {
      const alertBox = document.getElementById('scanAlertBox');
      alertBox.textContent = msg;
      alertBox.classList.remove('hidden');
      setTimeout(() => {
        alertBox.classList.add('hidden');
      }, 4000);
    }

    function handleManualQrSubmit() {
      const input = document.getElementById('manualQrInput');
      if (input && input.value.trim()) {
        processScannedQr(input.value.trim());
        input.value = '';
      }
    }

    function handleFileInput(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const html5Qr = new Html5Qrcode("reader");
        html5Qr.scanFile(file, true)
          .then(decodedText => {
            processScannedQr(decodedText);
          })
          .catch(err => {
            showScanAlert("⚠️ Could not read QR code from file.");
          });
      }
    }

    function updateBioCounter(textarea) {
      const countEl = document.getElementById('bioCharCount');
      if (countEl) {
        countEl.textContent = `${textarea.value.length}/250`;
      }
    }

    function updateBillDisplay() {
      const tbody = document.getElementById('receiptTableBody');
      const billNoEl = document.getElementById('receiptBillNo');
      const dateEl = document.getElementById('receiptDate');
      const timeEl = document.getElementById('receiptTime');
      const itemCountEl = document.getElementById('billItemCount');
      const grandTotalEl = document.getElementById('billGrandTotal');
      const cartCountBadge = document.getElementById('cartCountBadge');

      billNoEl.textContent = `Bill #: ${currentBillNo}`;
      const now = new Date();
      dateEl.textContent = `Date: ${now.toLocaleDateString()}`;
      timeEl.textContent = `Time: ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

      cartCountBadge.textContent = scannedBillCart.length;
      if (scannedBillCart.length > 0) {
        cartCountBadge.classList.remove('hidden');
      } else {
        cartCountBadge.classList.add('hidden');
      }

      if (scannedBillCart.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="py-8 text-center text-xs text-slate-400 italic">No QR codes scanned yet. Scan app QRs to build bill.</td>
          </tr>
        `;
        itemCountEl.textContent = '0';
        grandTotalEl.textContent = '₹ 0.00';
        renderReceiptQrPayload('NO_ITEMS');
        return;
      }

      let total = 0;
      let html = '';
      scannedBillCart.forEach((item, index) => {
        const itemTotal = item.price * item.qty;
        total += itemTotal;
        html += `
          <tr class="border-b border-slate-100 text-xs text-slate-700">
            <td class="py-2.5 px-2 font-semibold">${item.name}</td>
            <td class="py-2.5 px-2 text-slate-500">${item.color} / ${item.quality}</td>
            <td class="py-2.5 px-2 text-center font-bold">${item.qty}</td>
            <td class="py-2.5 px-2 text-right">₹${item.price.toFixed(2)}</td>
            <td class="py-2.5 px-2 text-right font-bold">₹${itemTotal.toFixed(2)}</td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
      itemCountEl.textContent = scannedBillCart.length;
      grandTotalEl.textContent = `₹ ${total.toFixed(2)}`;

      const qrPayloadText = `OFFICIAL RECEIPT VERIFICATION\nBill No: ${currentBillNo}\nDate: ${now.toLocaleDateString()}\nItems: ${scannedBillCart.length}\nTotal: Rs.${total.toFixed(2)}\nStatus: VERIFIED & PAID`;
      renderReceiptQrPayload(qrPayloadText);
    }

    function renderReceiptQrPayload(text) {
      const container = document.getElementById('receiptQrCanvas');
      if (!container) return;
      container.innerHTML = '';
      if (typeof QRCode !== 'undefined') {
        new QRCode(container, {
          text: text,
          width: 56,
          height: 56,
          colorDark: "#1E293B",
          colorLight: "#FFFFFF",
          correctLevel: QRCode.CorrectLevel.L
        });
      }
    }

    function clearBillCart() {
      scannedBillCart = [];
      currentBillNo = 'INV-' + Math.floor(100000 + Math.random() * 900000);
      updateBillDisplay();
    }
    function downloadBillImage() {
      const printArea = document.getElementById('receiptPrintArea');
      if (typeof html2canvas === 'undefined') {
        alert('Image export library loading. Please try again.');
        return;
      }
      html2canvas(printArea, { scale: 2 }).then(canvas => {
        const link = document.createElement('a');
        link.download = `${currentBillNo}_Receipt.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    }

    function printBillReceipt() {
      window.print();
    }

    // App Startup Trigger
    window.onFirebaseReady = () => {
      initRealtimeSync();
    };

    window.addEventListener('DOMContentLoaded', () => {
      initRealtimeSync();
      setTimeout(() => {
        if (qrPool.length === 0) {
          initQrPool();
        }
      }, 500);
    });
  </script>
</body>
</html>
                                               
              
